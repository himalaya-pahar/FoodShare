FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SENTENCE_TRANSFORMERS_HOME=/opt/sentence-transformers \
    HF_HOME=/opt/huggingface

WORKDIR /app

COPY requirements.txt requirements-ai.txt ./
RUN pip install --no-cache-dir -r requirements-ai.txt

# Copy only the application modules needed by the AI service. In particular,
# do not copy the developer's local .env file into the image.
COPY ai ./ai
COPY ai_service ./ai_service
COPY security ./security
COPY config.py database.py models.py ./
COPY scripts ./scripts

# Cache the model at image build time so requests never need to download it.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

CMD ["sh", "-c", "uvicorn ai_service.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
