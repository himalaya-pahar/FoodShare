# Database
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres?sslmode=require

# JWT Auth
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase Storage & Credentials
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co/rest/v1/
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY

# Bucket Names (keep these exact names)
SUPABASE_PROFILE_IMAGES_BUCKET=profile-images
SUPABASE_DONATION_MEDIA_BUCKET=donation-media

# Startup configuration
CREATE_TABLES_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Email Verification & Gmail SMTP (Development)
# ---------------------------------------------------------------------------
# In development, you can use your personal Gmail account with a Gmail App Password
# Note: Generate an App Password at: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=FoodShare
SMTP_USE_TLS=true

# Frontend and Backend URLs for email links
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Verification rate limiting (seconds cooldown before resending)
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Verification token expiration in hours (0 = disabled during development)
VERIFICATION_TOKEN_EXPIRE_HOURS=0


# ---------------------------------------------------------------------------
# AI Assistant (RAG)
# ---------------------------------------------------------------------------

# LLM provider (initial: gemini). To switch providers later, set LLM_PROVIDER
# to a name registered in ai/generation/llm.py.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
GEMINI_API_KEY=

# Embeddings (local sentence-transformers). The model is downloaded the
# first time the model is used during local development. The Render image
# preloads it at build time. No API token required.
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SENTENCE_TRANSFORMERS_HOME=  # optional override of the cache directory
AI_CORS_ORIGINS=*

# Vector search tuning
AI_TOP_K=5
AI_SIMILARITY_THRESHOLD=0.30
# Skip pgvector ivfflat index creation below this row count (sequential scan
# is faster and avoids the silent-empty-result bug from over-partitioned
# ivfflat). When the table crosses this size the index is created on the
# next reindex, with `lists = clamp(sqrt(rows), 10, 1000)`.
AI_IVFFLAT_MIN_ROWS=1000

# Chunking
AI_CHUNK_SIZE=800
AI_CHUNK_OVERLAP=120

# Conversation memory
AI_SESSION_TTL_MINUTES=60
AI_SESSION_MAX_TURNS=6

# Observability (do NOT enable in production — may log user prompts)
AI_DEBUG_LOG_CONTENT=false
